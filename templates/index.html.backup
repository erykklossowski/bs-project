<!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <title>aFRR-down Black-Scholes Valuation</title>
  <script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
  <style>
    :root { --fg:#111; --muted:#666; --bg:#fff; --accent:#0b6cff; --success:#28a745; --warning:#ffc107; --info:#17a2b8; }
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial; color:var(--fg); background:var(--bg); margin:24px; line-height:1.5; }
    .wrap { max-width: 1200px; margin: 0 auto; }
    h1 { font-size: 24px; margin: 0 0 8px; color:var(--accent); }
    .subtitle { font-size: 14px; color:var(--muted); margin-bottom: 20px; }
    fieldset { border:1px solid #ddd; padding:16px; margin:16px 0; border-radius:8px; background:#fdfdfd; }
    legend { color:var(--accent); font-size:14px; font-weight:600; padding:0 8px; }
    label { display:inline-block; margin:8px 12px 8px 0; font-size: 13px; color:var(--muted); min-width:80px; }
    input, select, textarea { padding:8px 10px; margin:4px 8px 8px 0; border:1px solid #ccc; border-radius:6px; font-size:13px; }
    button { background:var(--accent); color:#fff; border:0; padding:12px 18px; border-radius:8px; cursor:pointer; font-size:14px; font-weight:500; margin:4px 8px 4px 0; }
    button:hover { opacity:0.9; }
    button:disabled { opacity:0.6; cursor:not-allowed; }
    .btn-success { background:var(--success); }
    .btn-warning { background:var(--warning); }
    .btn-info { background:var(--info); }
    .grid { display:grid; grid-template-columns: 1fr 1fr; gap:16px; }
    .grid-3 { display:grid; grid-template-columns: 1fr 1fr 1fr; gap:12px; }
    .summary { background:linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border:1px solid #dee2e6; padding:20px; border-radius:12px; margin:20px 0; }
    .summary h3 { margin:0 0 16px; color:var(--accent); }
    .kvs { display:grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap:12px; font-size:13px; }
    .metric { background:white; padding:12px; border-radius:6px; border:1px solid #e9ecef; }
    .metric-label { color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:0.5px; }
    .metric-value { font-size:16px; font-weight:600; color:var(--fg); }
    .chart { height:400px; border:1px solid #eee; border-radius:8px; margin:16px 0; background:white; }
    .error { color:#dc3545; background:#f8d7da; border:1px solid #f5c6cb; padding:12px; border-radius:6px; margin:16px 0; }
    .success { color:#155724; background:#d4edda; border:1px solid #c3e6cb; padding:12px; border-radius:6px; margin:16px 0; }
    .info { color:#0c5460; background:#d1ecf1; border:1px solid #bee5eb; padding:12px; border-radius:6px; margin:16px 0; }
    .downloads { background:#d1ecf1; border:1px solid #bee5eb; padding:16px; border-radius:8px; margin:20px 0; }
    .downloads h3 { margin:0 0 12px; color:#0c5460; }
    .download-link { display:inline-block; background:var(--success); color:white; padding:8px 12px; margin:4px 8px 4px 0; text-decoration:none; border-radius:4px; font-size:12px; }
    .download-link:hover { opacity:0.8; }
    .help-text { font-size:12px; color:var(--muted); margin-top:4px; font-style:italic; }
    .data-status { padding:16px; border-radius:8px; margin:16px 0; border:1px solid #dee2e6; background:#f8f9fa; }
    .status-indicator { display:inline-block; width:10px; height:10px; border-radius:50%; margin-right:8px; }
    .status-available { background:var(--success); }
    .status-unavailable { background:#dc3545; }
    .status-fetching { background:var(--warning); animation: pulse 1s infinite; }
    @keyframes pulse { 0%, 100% { opacity:1; } 50% { opacity:0.5; } }
    .progress-bar { width:100%; height:20px; background:#e9ecef; border-radius:10px; overflow:hidden; margin:8px 0; }
    .progress-fill { height:100%; background:var(--accent); transition:width 0.3s ease; }
    .fetch-controls { background:#fff3cd; border:1px solid #ffeaa7; padding:16px; border-radius:8px; margin:16px 0; }
    .nav-links { margin-bottom: 20px; }
    .nav-links a { color: var(--accent); text-decoration: none; padding: 8px 16px; border: 1px solid var(--accent); border-radius: 6px; margin-right: 8px; font-size: 13px; }
    .nav-links a:hover { background: var(--accent); color: white; }
  </style>
</head>
<body>
<div class="wrap">
  <h1>aFRR-down Black-Scholes Valuation</h1>
  <div class="subtitle">Automatic PSE data integration with complete Black-Scholes option pricing</div>

  <div class="nav-links">
    <a href="/">Single-Bid Model</a>
    <a href="/two-bids">Two-Bid Model →</a>
  </div>

  {% if error %}<div class="error"><strong>Error:</strong> {{ error }}</div>{% endif %}

  <!-- PSE Data Status -->
  <div class="data-status">
    <h3>📊 PSE Data Status</h3>
    <div style="margin-bottom:12px;">
      {% if auto_data_available %}
        <span class="status-indicator status-available"></span>
        <strong>Data Available</strong> - aFRR prices, volumes, and predictors ready for analysis
      {% else %}
        <span class="status-indicator status-unavailable"></span>
        <strong>No Data</strong> - Please fetch PSE data to begin analysis
      {% endif %}
    </div>
    
    {% if fetch_status and fetch_status.status == 'fetching' %}
      <div id="fetch-progress">
        <div>Status: {{ fetch_status.message }}</div>
        <div class="progress-bar">
          <div class="progress-fill" style="width: {{ fetch_status.progress }}%"></div>
        </div>
      </div>
    {% endif %}
  </div>

  <!-- Data Fetching Controls -->
  <div class="fetch-controls">
    <h3>🔽 Download PSE Data</h3>
    <div class="help-text" style="margin-bottom:16px;">
      Automatically download aFRR-down capacity prices, procurement volumes, and market predictors from PSE API
    </div>
    
    <form id="fetch-form" style="margin-bottom:16px;">
      <div class="grid">
        <label>Start Date <input type="date" name="start_date" value="2024-07-01" required></label>
        <label>End Date <input type="date" name="end_date" value="2025-06-30" required></label>
      </div>
      <button type="submit" class="btn-info" id="fetch-btn">
        📥 Fetch aFRR Data from PSE
      </button>
    </form>

    <div class="help-text">
      <strong>Data Sources:</strong><br>
      • <strong>aFRR-down Prices:</strong> cmbu-tu endpoint (afrr_d field) - Primary underlying for Black-Scholes<br>
      • <strong>Procurement Volumes:</strong> zmb endpoint (zmb_afrrd field) - Actual MW for budget constraints<br>
      • <strong>Market Predictors:</strong> price-cost endpoint (CEN, COR, SK) - For μₜ drift modeling
    </div>
  </div>

  <!-- Analysis Parameters -->
  <form action="/run" method="post" id="analysis-form">

    <!-- Portfolio Parameters -->
    <fieldset>
      <legend>💼 Portfolio Configuration</legend>
      <div class="grid">
        <label>Portfolio Size <input name="portfolio_mw" type="number" step="0.1" value="{{ params.portfolio_mw if params else 50 }}" required> <span style="font-size:11px;">MW</span></label>
        <label>Output Prefix <input name="out_prefix" value="{{ params.out_prefix if params else 'web_valuation' }}" placeholder="web_valuation"></label>
      </div>
    </fieldset>

    <!-- Bidding Parameters -->
    <fieldset>
      <legend>📊 Bidding Strategy</legend>
      <div class="grid">
        <label>Bidding Mode
          <select name="bidding_mode" id="bidding_mode">
            <option value="single" {{ 'selected' if (params and params.bidding_mode=='single') else '' }}>Single Bid Level</option>
            <option value="banded" {{ 'selected' if (params and params.bidding_mode=='banded') else '' }}>Banded Bidding</option>
          </select>
        </label>
      </div>
      
      <div id="single_bid_section" class="grid" style="display: {{ 'block' if (not params or params.bidding_mode=='single') else 'none' }};">
        <label>Strike Price K <input name="single_K" type="number" step="0.01" value="{{ params.single_K if params else 400 }}" required> <span style="font-size:11px;">PLN/MW-h</span></label>
      </div>
      
      <div id="banded_bid_section" style="display: {{ 'block' if (params and params.bidding_mode=='banded') else 'none' }};">
        <label>Banded Bids <input name="bands_input" type="text" value="{{ params.bands_input if params else '' }}" placeholder="0.4:300,0.4:400,0.2:500"> 
          <small style="display:block;color:#666;font-size:11px;">Format: fraction:bid (e.g., 0.4:300,0.4:400,0.2:500)</small>
        </label>
      </div>
    </fieldset>

    <!-- Model Parameters -->
    <fieldset>
      <legend>🧮 Model Configuration</legend>
      <div class="grid">
        <label>Model Mode
          <select name="model_mode">
            <option value="parametric" {{ 'selected' if (not params or params.model_mode=='parametric') else '' }}>Parametric (Lognormal)</option>
            <option value="empirical" {{ 'selected' if (params and params.model_mode=='empirical') else '' }}>Empirical CDF</option>
          </select>
        </label>
        <label>Ridge λ <input name="ridge" type="number" step="0.1" value="{{ params.ridge if params else 1.0 }}" required></label>
      </div>
    </fieldset>

    <!-- Energy Leg Parameters -->
    <fieldset>
      <legend>⚡ Energy Leg (Optional)</legend>
      <div class="grid">
        <label>
          <input type="checkbox" name="enable_energy_leg" id="enable_energy_leg" {{ 'checked' if (params and params.enable_energy_leg) else '' }}>
          Enable Energy Leg Analysis
        </label>
      </div>
      
      <div id="energy_leg_section" style="display: {{ 'block' if (params and params.enable_energy_leg) else 'none' }};">
        <div class="grid">
          <label>Theta Values <input name="theta_values" type="text" value="{{ params.theta_values if params else '0.005,0.01,0.02,0.05' }}" placeholder="0.005,0.01,0.02,0.05">
            <small style="display:block;color:#666;font-size:11px;">Activation intensities (comma-separated)</small>
          </label>
          <label>Risk Uplift <input name="risk_uplift" type="number" step="0.01" value="{{ params.risk_uplift if params else 0.15 }}" min="0" max="1">
            <small style="display:block;color:#666;font-size:11px;">Factor (0.15 = 15%)</small>
          </label>
        </div>
        <div style="background:#f8f9fa;padding:10px;border-radius:4px;font-size:12px;color:#666;margin-top:10px;">
          <strong>Note:</strong> Energy leg requires balancing energy price and alternative price data. Currently uses synthetic data for demonstration.
        </div>
      </div>
    </fieldset>

    <input type="hidden" name="use_auto_data" value="true">

    <div class="help-text" style="background:#e7f3ff; padding:12px; border-radius:6px; margin:16px 0;">
      <strong>🔍 Data Architecture (Automatic):</strong><br>
      • <strong>Underlying S(t):</strong> afrr_d prices → Black-Scholes option valuation<br>
      • <strong>Budget constraints:</strong> price × zmb_afrrd_mw × 0.25h per interval<br>
      • <strong>Drift modeling μₜ:</strong> CEN/COR/SK predictors via Ridge regression<br>
      • <strong>Time alignment:</strong> All data synchronized to 15-minute UTC intervals
    </div>

    <button type="submit" class="btn-success" 
            {% if not auto_data_available %}disabled{% endif %}>
      🚀 Run aFRR-Down Analysis
    </button>
    
    {% if not auto_data_available %}
      <div class="help-text" style="color:var(--warning); margin-top:8px;">
        <em>Please fetch PSE data first before running analysis</em>
      </div>
    {% endif %}
  </form>

  {% if summary %}
  <div class="summary">
    <h3>📈 aFRR-Down Valuation Results</h3>
    <div style="margin-bottom:16px; font-size:14px;">
      <strong>Portfolio:</strong> {{ '{:,.1f}'.format(summary.portfolio_mw) }} MW, 
      <strong>Model:</strong> {{ summary.model_mode }}, 
      <strong>Intervals:</strong> {{ '{:,}'.format(summary.total_intervals) }}
    </div>
    
    <div class="kvs">
      <div class="metric">
        <div class="metric-label">Per-MW Revenue (Baseline)</div>
        <div class="metric-value">{{ '{:,.0f}'.format(summary.capacity_perMW_baseline_PLN) }} PLN/MW</div>
      </div>
      
      <div class="metric">
        <div class="metric-label">Per-MW Revenue (Capped)</div>
        <div class="metric-value">{{ '{:,.0f}'.format(summary.capacity_perMW_capped_PLN) }} PLN/MW</div>
      </div>
      
      <div class="metric">
        <div class="metric-label">Portfolio Revenue (Baseline)</div>
        <div class="metric-value">{{ '{:,.0f}'.format(summary.portfolio_baseline_PLN) }} PLN</div>
      </div>
      
      <div class="metric">
        <div class="metric-label">Portfolio Revenue (Capped)</div>
        <div class="metric-value">{{ '{:,.0f}'.format(summary.portfolio_capped_PLN) }} PLN</div>
      </div>
      
      <div class="metric">
        <div class="metric-label">Budget-Bound Intervals</div>
        <div class="metric-value">{{ '{:.1f}'.format(summary.bound_intervals_pct) }}%</div>
      </div>
      {% if summary.model_params and summary.model_params.sigma %}
      <div class="metric">
        <div class="metric-label">Model Volatility σ</div>
        <div class="metric-value">{{ '{:.3f}'.format(summary.model_params.sigma) }}</div>
      </div>
      {% endif %}
    </div>
    
    <!-- Bid Analysis -->
    {% if summary.acceptance_stats %}
    <div style="margin-top:20px;">
      <h4>🎯 Bid Analysis</h4>
      <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
          <thead>
            <tr style="background:#f8f9fa;">
              <th style="padding:6px;border:1px solid #ddd;text-align:center;">Band</th>
              <th style="padding:6px;border:1px solid #ddd;text-align:center;">Fraction</th>
              <th style="padding:6px;border:1px solid #ddd;text-align:center;">Bid K</th>
              <th style="padding:6px;border:1px solid #ddd;text-align:center;">Acceptance Prob</th>
              <th style="padding:6px;border:1px solid #ddd;text-align:center;">Expected MWh</th>
            </tr>
          </thead>
          <tbody>
            {% for bid_stat in summary.acceptance_stats %}
            <tr>
              <td style="padding:6px;border:1px solid #ddd;text-align:center;">{{ bid_stat.band }}</td>
              <td style="padding:6px;border:1px solid #ddd;text-align:center;">{{ '{:.1%}'.format(bid_stat.fraction) }}</td>
              <td style="padding:6px;border:1px solid #ddd;text-align:right;">{{ '{:,.0f}'.format(bid_stat.bid_K) }}</td>
              <td style="padding:6px;border:1px solid #ddd;text-align:right;">{{ '{:.3f}'.format(bid_stat.avg_acceptance_prob) }}</td>
              <td style="padding:6px;border:1px solid #ddd;text-align:right;">{{ '{:,.0f}'.format(bid_stat.expected_MWh) }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endif %}
    
    <!-- Energy Leg Results -->
    {% if summary.energy_leg %}
    <div style="margin-top:20px;">
      <h4>⚡ Energy Leg Results</h4>
      <div class="metric" style="margin-bottom:10px;">
        <div class="metric-label">Expected Loss</div>
        <div class="metric-value">{{ '{:.2f}'.format(summary.energy_leg.energy_loss_pln_per_mwh) }} PLN/MWh</div>
      </div>
      
      {% if summary.energy_leg.theta_sweep %}
      <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
          <thead>
            <tr style="background:#f8f9fa;">
              <th style="padding:6px;border:1px solid #ddd;text-align:center;">Activation θ</th>
              <th style="padding:6px;border:1px solid #ddd;text-align:center;">Premium Floor</th>
              <th style="padding:6px;border:1px solid #ddd;text-align:center;">Recommended</th>
            </tr>
          </thead>
          <tbody>
            {% for theta_result in summary.energy_leg.theta_sweep %}
            <tr>
              <td style="padding:6px;border:1px solid #ddd;text-align:center;">{{ '{:.1f}%'.format(theta_result.theta_pct) }}</td>
              <td style="padding:6px;border:1px solid #ddd;text-align:right;">{{ '{:.2f}'.format(theta_result.premium_floor_pln_per_mwh) }}</td>
              <td style="padding:6px;border:1px solid #ddd;text-align:right;">{{ '{:.2f}'.format(theta_result.premium_recommended_pln_per_mwh) }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>

  {% if download_files %}
  <div class="downloads">
    <h3>📥 Download Analysis Results</h3>
    {% for key, file_info in download_files.items() %}
      <a href="{{ file_info.path }}" class="download-link" download>{{ file_info.name }}</a>
    {% endfor %}
  </div>
  {% endif %}

  <div id="chart_accept" class="chart"></div>
  <div id="chart_price" class="chart"></div>
  <div id="chart_budget" class="chart"></div>
  {% endif %}
</div>

<script>
// Form interactivity
document.addEventListener('DOMContentLoaded', function() {
  // Bidding mode switching
  const biddingModeSelect = document.getElementById('bidding_mode');
  const singleBidSection = document.getElementById('single_bid_section');
  const bandedBidSection = document.getElementById('banded_bid_section');
  
  function updateBiddingMode() {
    const mode = biddingModeSelect.value;
    if (mode === 'single') {
      singleBidSection.style.display = 'block';
      bandedBidSection.style.display = 'none';
    } else if (mode === 'banded') {
      singleBidSection.style.display = 'none';
      bandedBidSection.style.display = 'block';
    }
  }
  
  biddingModeSelect.addEventListener('change', updateBiddingMode);
  updateBiddingMode(); // Initialize
  
  // Energy leg toggle
  const energyLegCheckbox = document.getElementById('enable_energy_leg');
  const energyLegSection = document.getElementById('energy_leg_section');
  
  function updateEnergyLeg() {
    energyLegSection.style.display = energyLegCheckbox.checked ? 'block' : 'none';
  }
  
  energyLegCheckbox.addEventListener('change', updateEnergyLeg);
  updateEnergyLeg(); // Initialize
});

// Data fetching functionality
document.getElementById('fetch-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  
  const formData = new FormData(e.target);
  const fetchBtn = document.getElementById('fetch-btn');
  const originalText = fetchBtn.textContent;
  
  // Disable button and show fetching state
  fetchBtn.disabled = true;
  fetchBtn.textContent = '⏳ Fetching Data...';
  
  try {
    const response = await fetch('/fetch-data', {
      method: 'POST',
      body: formData
    });
    
    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }
    
    const result = await response.json();
    
    // Start polling for status updates
    pollFetchStatus();
    
  } catch (error) {
    alert(`Failed to start data fetch: ${error.message}`);
    fetchBtn.disabled = false;
    fetchBtn.textContent = originalText;
  }
});

// Poll for fetch status updates
async function pollFetchStatus() {
  try {
    const response = await fetch('/fetch-status');
    const status = await response.json();
    
    updateFetchStatus(status);
    
    if (status.status === 'fetching' || status.status === 'processing') {
      setTimeout(pollFetchStatus, 2000); // Poll every 2 seconds
    } else {
      // Fetch completed or failed, re-enable button and reload page
      setTimeout(() => {
        location.reload();
      }, 2000);
    }
  } catch (error) {
    console.error('Error polling fetch status:', error);
  }
}

// Update fetch status display
function updateFetchStatus(status) {
  const progressDiv = document.getElementById('fetch-progress');
  
  if (status.status === 'fetching' || status.status === 'processing') {
    if (!progressDiv) {
      // Create progress display if it doesn't exist
      const statusDiv = document.querySelector('.data-status');
      statusDiv.innerHTML += `
        <div id="fetch-progress">
          <div id="status-message">Status: ${status.message}</div>
          <div class="progress-bar">
            <div class="progress-fill" style="width: ${status.progress}%"></div>
          </div>
        </div>
      `;
    } else {
      // Update existing progress
      document.getElementById('status-message').textContent = `Status: ${status.message}`;
      document.querySelector('.progress-fill').style.width = `${status.progress}%`;
    }
  }
}

{% if chart %}
// Chart rendering
const DT = {{ chart.dt|tojson }};
const PACC = {{ chart.p_accept|tojson if chart.p_accept is defined else '[]' }};
const PRICE = {{ chart.price_pln_per_mw_h|tojson }};
const STRIKE = {{ chart.strike_line|tojson }};
const MW = {{ chart.mw_procured|tojson }};
const BUDGET = {{ chart.budget_pln_interval|tojson }};
const PLN_CAP = {{ chart.pln_portfolio_capped|tojson if chart.pln_portfolio_capped is defined else '[]' }};

// 1) Acceptance probability
if (PACC.length > 0) {
  Plotly.newPlot('chart_accept', [{
      x: DT, y: PACC, mode: 'lines', name: 'Acceptance Probability', 
      line: {color: '#0b6cff', width: 2}
    }], {
      title: 'Option Acceptance Probability Over Time',
      yaxis: { rangemode:'tozero', tickformat: '.1%', hoverformat: '.2%', title: 'Probability' },
      xaxis: { type:'date', title: 'Date' }, 
      margin: {t:50, b:50, l:60, r:30},
      plot_bgcolor: '#fafafa'
    }, {displayModeBar:false, responsive:true});
}

// 2) aFRR-down price vs strike
Plotly.newPlot('chart_price', [
  { x: DT, y: PRICE, mode: 'lines', name: 'aFRR-down Price', line: {color: '#28a745', width: 2} },
  { x: DT, y: STRIKE, mode: 'lines', name: 'Strike K', line: {dash:'dot', color: '#dc3545', width: 2} }
], {
  title: 'aFRR-down Capacity Price vs Strike Price',
  xaxis: { type: 'date', title: 'Date' }, 
  yaxis: { rangemode:'tozero', title: 'Price (PLN/MW-h)' }, 
  margin: {t:50, b:50, l:80, r:30},
  plot_bgcolor: '#fafafa',
  legend: { x: 0, y: 1 }
}, {displayModeBar:false, responsive:true});

// 3) Procured MW / budget / capped portfolio PLN
const traces = [
  { x: DT, y: MW, name: 'Procured MW', yaxis:'y1', mode:'lines', line: {color: '#6f42c1', width: 2} },
  { x: DT, y: BUDGET, name: 'Budget (PLN/interval)', yaxis:'y2', mode:'lines', line: {color: '#fd7e14', width: 2} }
];
if (PLN_CAP.length) {
  traces.push({ 
    x: DT, y: PLN_CAP, name:'Portfolio PLN (capped)', yaxis:'y2', mode:'lines',
    line: {color: '#20c997', width: 2, dash: 'dash'}
  });
}

Plotly.newPlot('chart_budget', traces, {
  title: 'Procured MW & Budget vs Portfolio Revenue (Capped)',
  xaxis: { type:'date', title: 'Date' },
  yaxis:  { title:'Procured MW', rangemode:'tozero', side: 'left' },
  yaxis2: { title:'PLN per Interval', overlaying:'y', side:'right', rangemode:'tozero' },
  margin: {t:50, b:50, l:80, r:80},
  plot_bgcolor: '#fafafa',
  legend: { x: 0, y: 1 }
}, {displayModeBar:false, responsive:true});
{% endif %}
</script>
</body>
</html>
